# Copiez ce fichier en `.env` puis adaptez les valeurs.
# Ne commitez JAMAIS le fichier `.env`.

# Environnement : development | production | test
NODE_ENV=development

# Port de l'API
PORT=3000

# Chemin du fichier SQLite (relatif au dossier backend)
DATABASE_PATH=data/travel-tr.sqlite

# Origines autorisées à appeler l'API avec des cookies (séparées par des virgules).
# Laissez vide si le frontend est servi par l'API ou via le proxy Angular (même origine).
CORS_ORIGINS=

# Cookies "Secure" (HTTPS uniquement). Mettre true en production.
COOKIE_SECURE=false

# Durée de vie d'une session, en heures
SESSION_TTL_HOURS=168

# Nombre de proxys inverses de confiance (ex. 1 derrière Nginx), 0 sinon
TRUST_PROXY=0

# Dossier du build Angular servi par l'API (optionnel)
# FRONTEND_DIST=../frontend/dist/travel-tr/browser
